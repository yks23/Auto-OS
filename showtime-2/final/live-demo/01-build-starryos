#!/usr/bin/env bash
set -euo pipefail

ROOT="${ROOT:-/Users/txc/code/Auto-OS}"
TGOS="${TGOS:-$ROOT/tgoskits}"
OUT_DIR="${OUT_DIR:-$ROOT/showtime-2/final/live-demo/out}"
ARCH="${ARCH:-aarch64}"
SMP="${SMP:-1}"
JOBS="${JOBS:-8}"
RAYON="${RAYON_NUM_THREADS:-$JOBS}"
PROFILE="${PROFILE:-aligned-fast}" # aligned-fast | xtask
STAMP="${STAMP:-$(date +%Y%m%dT%H%M%S)}"
LOG="${LOG:-$OUT_DIR/01-build-starryos-${ARCH}-smp${SMP}-j${JOBS}-${PROFILE}-${STAMP}.log}"

case "$ARCH" in
  aarch64) TARGET="aarch64-unknown-none-softfloat" ;;
  riscv64) TARGET="riscv64gc-unknown-none-elf" ;;
  *) echo "unsupported ARCH=$ARCH; expected aarch64 or riscv64" >&2; exit 2 ;;
esac

find_objcopy() {
  if [ -n "${OBJCOPY:-}" ] && [ -x "$OBJCOPY" ]; then
    printf '%s\n' "$OBJCOPY"
    return 0
  fi
  local sysroot host candidate
  sysroot="$(rustc --print sysroot 2>/dev/null || true)"
  host="$(rustc -vV 2>/dev/null | sed -n 's/^host: //p' || true)"
  candidate="$sysroot/lib/rustlib/$host/bin/llvm-objcopy"
  if [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  if command -v llvm-objcopy >/dev/null 2>&1; then
    command -v llvm-objcopy
    return 0
  fi
  return 1
}

check_env() {
  local ok=1
  [ -d "$TGOS" ] || { echo "missing TGOSKit checkout: $TGOS" >&2; ok=0; }
  for cmd in cargo rustc rsync perl; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "missing command: $cmd" >&2; ok=0; }
  done
  if [ "$PROFILE" = "aligned-fast" ]; then
    command -v ax-config-gen >/dev/null 2>&1 || { echo "missing command: ax-config-gen" >&2; ok=0; }
    [ "$ARCH" = "aarch64" ] || { echo "PROFILE=aligned-fast only supports ARCH=aarch64" >&2; ok=0; }
  fi
  find_objcopy >/dev/null 2>&1 || { echo "missing llvm-objcopy; install rust llvm-tools or set OBJCOPY=/path/to/llvm-objcopy" >&2; ok=0; }
  if [ "$ok" = "1" ]; then
    echo "===01-BUILD-STARRYOS-CHECK-PASS profile=$PROFILE arch=$ARCH smp=$SMP jobs=$JOBS==="
    return 0
  fi
  echo "===01-BUILD-STARRYOS-CHECK-FAIL==="
  return 1
}

if [ "${1:-}" = "--check" ]; then
  check_env
  exit $?
fi

mkdir -p "$OUT_DIR"
check_env >/dev/null

{
  echo "===01-BUILD-STARRYOS-BEGIN==="
  echo "purpose=host-side StarryOS kernel build"
  echo "profile=$PROFILE"
  echo "cwd=$TGOS"
  echo "arch=$ARCH"
  echo "target=$TARGET"
  echo "smp=$SMP"
  echo "CARGO_BUILD_JOBS=$JOBS"
  echo "RAYON_NUM_THREADS=$RAYON"
  echo "log=$LOG"

  start="$(date +%s)"
  if [ "$PROFILE" = "aligned-fast" ]; then
    helper="$ROOT/showtime-2/scripts/run-host-aligned-starryos-oracle.sh"
    [ -x "$helper" ] || { echo "missing helper: $helper" >&2; exit 1; }
    tmp_src="/private/tmp/auto-os-live-host-aligned-src-${STAMP}"
    tmp_target="/private/tmp/auto-os-live-host-aligned-target-${STAMP}"
    SRC_COPY="$tmp_src" TARGET_DIR="$tmp_target" LOG="$LOG" LOG_DIR="$OUT_DIR" ROOT="$ROOT" SRC_REPO="$TGOS" JOBS="$JOBS" SMP="$SMP" "$helper"
    ELF="$tmp_target/$TARGET/release/starryos"
    [ -f "$ELF" ] || { echo "missing aligned build output ELF: $ELF" >&2; exit 1; }
    cp "$ELF" "$OUT_DIR/starryos-host-${ARCH}-smp${SMP}.elf"
    "$(find_objcopy)" -O binary "$OUT_DIR/starryos-host-${ARCH}-smp${SMP}.elf" "$OUT_DIR/starryos-host-${ARCH}-smp${SMP}.bin"
    if [ "${KEEP_BUILD_TEMP:-0}" != "1" ]; then
      rm -rf "$tmp_src" "$tmp_target"
    fi
  elif [ "$PROFILE" = "xtask" ]; then
    (
      cd "$TGOS"
      export CARGO_BUILD_JOBS="$JOBS"
      export RAYON_NUM_THREADS="$RAYON"
      cargo xtask starry build --arch "$ARCH" --smp "$SMP"
    )
    ELF="$TGOS/target/$TARGET/release/starryos"
    BIN="$TGOS/target/$TARGET/release/starryos.bin"
    [ -f "$ELF" ] || { echo "missing build output ELF: $ELF" >&2; exit 1; }
    [ -f "$BIN" ] || { echo "missing build output BIN: $BIN" >&2; exit 1; }
    cp "$ELF" "$OUT_DIR/starryos-host-${ARCH}-smp${SMP}.elf"
    cp "$BIN" "$OUT_DIR/starryos-host-${ARCH}-smp${SMP}.bin"
  else
    echo "unsupported PROFILE=$PROFILE; expected xtask or aligned-fast" >&2
    exit 2
  fi
  end="$(date +%s)"
  elapsed="$((end - start))"

  echo "===01-BUILD-STARRYOS-OUTPUT==="
  ls -lh "$OUT_DIR/starryos-host-${ARCH}-smp${SMP}.elf" "$OUT_DIR/starryos-host-${ARCH}-smp${SMP}.bin"
  file "$OUT_DIR/starryos-host-${ARCH}-smp${SMP}.elf" "$OUT_DIR/starryos-host-${ARCH}-smp${SMP}.bin" || true
  echo "===01-BUILD-STARRYOS-PASS elapsed=$elapsed==="
} 2>&1 | tee "$LOG"
